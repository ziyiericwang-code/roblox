{
  "name": "global-command",
  "version": "0.1.0",
  "description": "Global Command: a 2D global military strategy game on a real-world map with ~1,200 provinces.",
  "type": "module",
  "private": true,
  "scripts": {
    "worldgen": "node --max-old-space-size=6000 tools/worldgen/build-world.mjs",
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && node src/server/index.js",
    "serve": "node src/server/index.js",
    "test": "node --test \"test/*.test.js\"",
    "e2e": "node scripts/e2e.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "earcut": "^3.0.1",
    "preact": "^10.29.8",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "playwright-core": "^1.48.0"
  }
}
